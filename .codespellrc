[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# The exact AWS snapshot is integrity-checked before the spelling check.
skip = .git*,vendor,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./codex-rs/third-party/aws-config/*
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH
