[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Both exact vendor snapshots are integrity-checked before the spelling check.
skip = .git*,vendor,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,./codex-rs/third-party/aws-config/*,./codex-rs/third-party/age/*
check-hidden = true
# WRONLY is a POSIX open flag; \oint and its Rust symbol-table key are LaTeX.
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b|\bWRONLY\b|\\oint\b|"oint"(?=\s*=>\s*"\u222e")
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH
