+            .collect();
+        let guard = Guard::install(timings);
+        assert!(catch_unwind(AssertUnwindSafe(|| Recipient::new(public_passphrase()))).is_err());
+        assert_eq!(guard.measured().len(), 21);
+        assert_eq!(guard.remaining(), 0);
+    }
+
+    #[test]
