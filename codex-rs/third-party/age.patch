+        let mut identity = Identity::new(public_passphrase());
+        identity.set_max_work_factor(18);
+        assert_eq!(
+            (identity.target_work_factor, identity.max_work_factor),
+            (15, 18)
+        );
+        assert_eq!(guard.remaining(), 0);
+    }
+
+    #[test]
