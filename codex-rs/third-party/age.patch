+            .collect();
+        timings.extend(samples(16, Duration::from_millis(40)));
+        let guard = Guard::install(timings);
+        assert_eq!(Recipient::new(public_passphrase()).log_n, 21);
+        assert_eq!(guard.measured().len(), 21);
+        assert_eq!(guard.remaining(), 0);
