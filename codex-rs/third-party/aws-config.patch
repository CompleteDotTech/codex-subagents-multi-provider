+    #[test]
+    fn dpop_proof_preserves_es256_wire_format_and_rejects_tampering() {
+        use p256::ecdsa::signature::Verifier;
+        use p256::ecdsa::VerifyingKey;
+
+        let endpoint = "https://signin.aws.amazon.com/v1/token";
+        let now = SystemTime::UNIX_EPOCH + Duration::from_secs(1651516560);
+        let private_key = SecretKey::from_sec1_pem(TEST_KEY).unwrap();
+        let proof = calculate(&private_key, endpoint, now).unwrap();
+        let parts: Vec<_> = proof.split('.').collect();
+        assert_eq!(parts.len(), 3);
+        let decode = |part: &str| base64_simd::URL_SAFE_NO_PAD.decode_to_vec(part).unwrap();
+        let header: serde_json::Value = serde_json::from_slice(&decode(parts[0])).unwrap();
+        assert_eq!(header["typ"], "dpop+jwt");
+        assert_eq!(header["alg"], "ES256");
+        assert_eq!(header["jwk"]["kty"], "EC");
+        assert_eq!(header["jwk"]["crv"], "P-256");
+        assert_eq!(
+            header["jwk"]["x"],
+            "Wb1VLi1EA2hJaTz4yYuxSELvY-1GAfL-8rUTCAdiFic"
+        );
+        assert_eq!(
+            header["jwk"]["y"],
+            "fOwX-hmPrNvtUaag79EaWYgyDAq2a7AIfkSvUt0Amhg"
+        );
+        let payload: serde_json::Value = serde_json::from_slice(&decode(parts[1])).unwrap();
+        assert_eq!(payload["htm"], "POST");
+        assert_eq!(payload["htu"], endpoint);
+        assert_eq!(payload["iat"], 1651516560_u64);
+        let jti = uuid::Uuid::parse_str(payload["jti"].as_str().unwrap()).unwrap();
+        assert_eq!(jti.get_version_num(), 4);
+        assert!(!proof.contains('='));
+
+        // Reconstruct the independently specified fixture public key, not a key
+        // exported from the signer, and verify the actual JWS signing input.
+        let mut public_key = vec![4];
+        public_key.extend(decode("Wb1VLi1EA2hJaTz4yYuxSELvY-1GAfL-8rUTCAdiFic"));
+        public_key.extend(decode("fOwX-hmPrNvtUaag79EaWYgyDAq2a7AIfkSvUt0Amhg"));
+        let verifier = VerifyingKey::from_sec1_bytes(&public_key).unwrap();
+        let signature_bytes = decode(parts[2]);
+        assert_eq!(
+            signature_bytes.len(),
+            64,
+            "JWS uses fixed-width R||S, not DER"
+        );
+        let signature = Signature::from_slice(&signature_bytes).unwrap();
+        let message = format!("{}.{}", parts[0], parts[1]);
+        verifier.verify(message.as_bytes(), &signature).unwrap();
+        assert!(verifier
+            .verify(format!("{message}tampered").as_bytes(), &signature)
+            .is_err());
+        assert!(Signature::from_slice(&signature_bytes[..63]).is_err());
+        let other_key = SecretKey::from_slice(&[1_u8; 32]).unwrap();
+        let other_verifier = VerifyingKey::from(other_key.public_key());
+        assert!(other_verifier
+            .verify(message.as_bytes(), &signature)
+            .is_err());
+        assert!(SecretKey::from_slice(&[0_u8; 32]).is_err());
+        assert!(SecretKey::from_slice(&[255_u8; 32]).is_err());
+        assert!(calculate(
+            &private_key,
+            endpoint,
+            SystemTime::UNIX_EPOCH - Duration::from_secs(1)
+        )
+        .is_err());
+    }
+}
